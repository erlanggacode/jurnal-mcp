JURNAL_CLIENT_ID=your_client_id_here
JURNAL_CLIENT_SECRET=your_client_secret_here
MCP_PORT=3000

# Optional: protect the /mcp endpoint with a bearer token.
# Generate a strong random key, e.g.: openssl rand -hex 32
# Leave unset to run without authentication (not recommended in production).
MCP_API_KEY=

# Optional: the exact public URL this server is reachable at, including scheme and port
# (e.g. https://your-host.example.com:3005). Required for the OAuth flow used by claude.ai /
# Cowork custom connectors when this server sits behind a reverse proxy (Tailscale Funnel,
# nginx, etc.) that may rewrite or drop the port from the Host header before forwarding —
# without this, the OAuth metadata can advertise a URL that doesn't match what the user
# entered in Claude, and the connector fails to connect. Not needed for plain LAN access.
PUBLIC_BASE_URL=

# Bank account mappings — find IDs in Jurnal.id > Pengaturan > Akun > Kas & Bank
# (open an account; the numeric ID appears in the page URL)
# Format: JSON array of objects with id, name, number
BANK_ACCOUNT_MAPPINGS=[{"id":1,"name":"BCA Operasional","number":"1234567890"},{"id":2,"name":"Mandiri","number":"9876543210"}]
